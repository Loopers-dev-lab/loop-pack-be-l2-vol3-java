### 상품 목록 조회
GET {{commerce-api}}/api-admin/v1/products?page=0&size=20

### 상품 상세 조회
GET {{commerce-api}}/api-admin/v1/products/1

### 상품 등록
POST {{commerce-api}}/api-admin/v1/products
Content-Type: application/json

{
  "brandId": 1,
  "name": "에어맥스",
  "price": 150000,
  "description": "나이키 에어맥스",
  "stockQuantity": 100,
  "status": "ON_SALE"
}

### 상품 수정
PUT {{commerce-api}}/api-admin/v1/products/1
Content-Type: application/json

{
  "brandId": 1,
  "name": "에어포스",
  "price": 120000,
  "description": "나이키 에어포스",
  "stockQuantity": 50,
  "status": "ON_SALE"
}

### 상품 삭제
DELETE {{commerce-api}}/api-admin/v1/products/1
