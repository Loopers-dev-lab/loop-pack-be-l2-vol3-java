// ==========================================================
// E-Commerce ERD - 현재 구현 범위 (Brand, Product, Like, Order)
// ==========================================================
// 설계 원칙:
//   - 소프트 삭제: 모든 테이블에 deleted_at (물리 삭제 금지)
//   - 상태 관리: status VARCHAR (코드 가독성 + 확장성)
//   - 조회 시 deleted_at IS NULL 조건 필수
//   - User 도메인은 1주차에 완성 (참조용 포함)
// ==========================================================

// =========================
// Core: User
// =========================
Table users {
  id             bigint [pk, increment, note: "사용자 PK"]
  login_id       varchar(80) [unique, not null, note: "로그인 아이디(유니크)"]
  email          varchar(255) [unique, not null, note: "이메일(유니크)"]
  password_hash  varchar(255) [not null, note: "비밀번호 해시(평문 금지)"]
  name           varchar(100) [not null, note: "표시명"]
  birth_date     date [note: "YYYY-MM-DD (ISO 8601)"]
  phone          varchar(50) [note: "연락처"]
  status         varchar(20) [not null, note: "USER_STATUS: ACTIVE, INACTIVE, BLOCKED"]
  last_login_at  timestamp [note: "마지막 로그인 시각"]
  deleted_at     timestamp [note: "soft delete. NULL이면 활성"]
  created_at     timestamp [not null, note: "생성 시각"]
  updated_at     timestamp [not null, note: "수정 시각"]

  Indexes {
    (email) [unique]
    (login_id) [unique]
    (status)
    (deleted_at)
  }

  note: "User(회원) - 1주차 완성. 2주차에서는 FK 참조만 사용"
}

// =========================
// Brand (브랜드)
// =========================
Table brands {
  id          bigint [pk, increment, note: "브랜드 PK"]
  name        varchar(150) [not null, note: "브랜드명"]
  description text [note: "브랜드 설명"]
  status      varchar(20) [not null, default: 'ACTIVE', note: "BRAND_STATUS: ACTIVE, INACTIVE"]
  deleted_at  timestamp [note: "soft delete"]
  created_at  timestamp [not null, note: "생성 시각"]
  updated_at  timestamp [not null, note: "수정 시각"]

  Indexes {
    (status)
    (deleted_at)
  }

  note: "Brand(브랜드). 삭제 시 소속 products도 연쇄 soft delete"
}

// =========================
// Product (상품)
// =========================
Table products {
  id          bigint [pk, increment, note: "상품 PK"]
  brand_id    bigint [not null, note: "brands.id FK"]
  name        varchar(200) [not null, note: "상품명"]
  description text [note: "상세 설명"]
  list_price  int [not null, note: "정가(할인 전 가격)"]
  sale_price  int [not null, note: "판매가"]
  stock       int [not null, default: 0, note: "재고 수량(0 이상). 현재 구현 범위에서는 상품 단위 재고"]
  like_count  int [not null, default: 0, note: "좋아요 수(0 이상). 좋아요순 정렬용 비정규화"]
  status      varchar(20) [not null, default: 'ACTIVE', note: "PRODUCT_STATUS: ACTIVE, SOLD_OUT, HIDDEN, DISCONTINUED"]
  deleted_at  timestamp [note: "soft delete"]
  created_at  timestamp [not null, note: "생성 시각"]
  updated_at  timestamp [not null, note: "수정 시각"]

  Indexes {
    (brand_id)
    (status)
    (deleted_at)
    (created_at)    // 최신순 정렬
    (sale_price)    // 가격순 정렬
    (like_count)    // 좋아요순 정렬
  }

  note: '''
    Product(상품).
    - stock: 주문 시 원자적 차감 (SELECT FOR UPDATE 또는 WHERE stock >= ?)
    - like_count: 등록/취소 시 동기 증감. 동시성은 원자적 UPDATE로 대응
    - 향후 Variant/옵션별 재고가 필요하면 inventories 테이블로 분리
  '''
}

// =========================
// Like: Product / Brand
// =========================
Table product_likes {
  id          bigint [pk, increment, note: "상품 좋아요 PK"]
  user_id     bigint [not null, note: "users.id FK"]
  product_id  bigint [not null, note: "products.id FK"]
  deleted_at  timestamp [note: "soft delete (취소 시 deleted_at = now())"]
  created_at  timestamp [not null, note: "좋아요 시각"]

  Indexes {
    (user_id, product_id) [unique, note: "중복 좋아요 방지. soft delete 조합은 앱 검증 우선 + DB UK 안전망"]
    (user_id)             // 내 좋아요 목록 조회
    (product_id)          // 상품별 좋아요 조회
    (deleted_at)
  }

  note: '''
    ProductLike(상품 좋아요).
    - (user_id, product_id) UNIQUE + deleted_at 조합 정책:
      방안 A: 취소 시 hard delete -> UK 자연 보장 (단순, 이력 없음)
      방안 B: generated column -> UNIQUE(user_id, product_id, active_flag)
      방안 C: 앱에서 선조회 후 제어 + DB UK는 안전망 (채택)
  '''
}

Table brand_likes {
  id          bigint [pk, increment, note: "브랜드 좋아요 PK"]
  user_id     bigint [not null, note: "users.id FK"]
  brand_id    bigint [not null, note: "brands.id FK"]
  deleted_at  timestamp [note: "soft delete"]
  created_at  timestamp [not null, note: "좋아요 시각"]

  Indexes {
    (user_id, brand_id) [unique, note: "중복 좋아요 방지"]
    (user_id)
    (brand_id)
    (deleted_at)
  }

  note: "BrandLike(브랜드 좋아요). product_likes와 동일한 UK + soft delete 정책"
}

// =========================
// Order (주문)
// =========================
Table orders {
  id            bigint [pk, increment, note: "주문 PK"]
  order_number  varchar(50) [unique, not null, note: "외부 노출 주문번호(예: ORD-20260213-00001)"]
  user_id       bigint [not null, note: "users.id FK"]
  status        varchar(20) [not null, default: 'PLACED', note: "ORDER_STATUS: PLACED, PAID, CANCELED"]
  total_amount  int [not null, note: "주문 총액 (order_items.line_total의 합)"]
  deleted_at    timestamp [note: "soft delete"]
  created_at    timestamp [not null, note: "주문 시각"]
  updated_at    timestamp [not null, note: "수정 시각"]

  Indexes {
    (order_number) [unique]
    (user_id, created_at)   // 사용자별 날짜 범위 조회
    (status)
    (deleted_at)
  }

  note: '''
    Order(주문).
    - PLACED: 주문 생성(재고 차감 완료)
    - PAID: 결제 완료(향후 확장)
    - CANCELED: 취소(PLACED 상태에서만 가능)
    - 주문 취소는 status=CANCELED로 관리 (deleted_at soft delete와 별도)
  '''
}

// =========================
// OrderItem (주문항목 - 스냅샷)
// =========================
Table order_items {
  id            bigint [pk, increment, note: "주문항목 PK"]
  order_id      bigint [not null, note: "orders.id FK"]
  product_id    bigint [not null, note: "원본 상품 ID (추적/정산용, FK 아님)"]
  product_name  varchar(200) [not null, note: "상품명 스냅샷"]
  brand_name    varchar(150) [not null, note: "브랜드명 스냅샷"]
  unit_price    int [not null, note: "단가 스냅샷 (주문 시점 판매가)"]
  quantity      int [not null, note: "주문 수량 (1 이상)"]
  line_total    int [not null, note: "라인 합계 (unit_price * quantity)"]
  created_at    timestamp [not null, note: "생성 시각"]

  Indexes {
    (order_id)
  }

  note: '''
    OrderItem(주문항목 스냅샷).
    - product_name, brand_name, unit_price: 주문 시점 값 고정 저장
    - 원본 상품이 변경/삭제되어도 주문 상세는 당시 정보 유지
    - product_id: FK constraint 없음 (상품 삭제 시에도 주문 데이터 유지)
    - deleted_at 없음: 스냅샷이므로 변경/삭제 불가 (주문과 생명주기 동일)
  '''
}

// ==========================================================
// [확장] Inventory (재고 예약 모델) - 향후 개발
// ==========================================================
// 현재 구현 범위: products.stock으로 단순 재고 관리
// 확장 시: inventories 테이블로 분리하여 예약(reservation) 모델 도입
//   - 결제 중 재고를 홀드(reserved_qty)하고, 결제 성공 시 확정 차감
//   - 향후 Variant 도입 시 product_id → variant_id로 전환

// =========================
// Inventory (재고 - 예약 모델)
// =========================
Table inventories {
  id            bigint [pk, increment, note: "재고 PK"]
  product_id    bigint [not null, note: "products.id FK. 향후 Variant 도입 시 variant_id로 전환"]
  quantity      int [not null, default: 0, note: "가용 재고 수량 (0 이상)"]
  reserved_qty  int [not null, default: 0, note: "예약 재고 수량 (0 이상). 결제 진행 중 홀드"]
  safety_stock  int [not null, default: 0, note: "안전재고 (경고 기준)"]
  deleted_at    timestamp [note: "soft delete"]
  created_at    timestamp [not null]
  updated_at    timestamp [not null]

  Indexes {
    (product_id) [unique, note: "상품당 재고 1건. 향후 variant_id로 전환"]
    (deleted_at)
  }

  note: '''
    Inventory(재고 예약 모델).
    - 가용 수량 = quantity - reserved_qty (0 이상)
    - 주문서(OrderSheet) 생성 시: reserved_qty += 수량 (HELD)
    - 결제 성공 시: quantity -= 수량, reserved_qty -= 수량 (CONFIRMED)
    - 결제 실패/만료 시: reserved_qty -= 수량 (RELEASED)
    - 현재 구현에서는 products.stock으로 즉시 차감 방식 사용
    - 향후 Variant 도입 시 product_id를 variant_id로 전환
  '''
}

// ==========================================================
// [확장] Coupon (쿠폰) - 향후 개발
// ==========================================================

// =========================
// CouponTemplate (쿠폰 정책 마스터 - 어드민 생성)
// =========================
Table coupon_templates {
  id                  bigint [pk, increment, note: "쿠폰 템플릿 PK"]
  name                varchar(200) [not null, note: "쿠폰명"]
  description         text [note: "쿠폰 설명"]
  discount_type       varchar(20) [not null, note: "DISCOUNT_TYPE: FIXED(정액), PERCENT(정률)"]
  discount_value      int [not null, note: "할인값 (정액: 금액, 정률: 퍼센트)"]
  max_discount_amount int [note: "정률 최대 할인액 (선택, PERCENT일 때만 유효)"]
  min_order_amount    int [not null, note: "최소 주문금액"]
  valid_from          timestamp [not null, note: "유효 시작일"]
  valid_until         timestamp [not null, note: "유효 종료일"]
  issue_limit         int [note: "전체 발급 제한 (NULL이면 무제한)"]
  per_user_limit      int [note: "유저별 발급 제한 (NULL이면 무제한)"]
  status              varchar(20) [not null, note: "COUPON_STATUS: ACTIVE, INACTIVE, EXPIRED"]
  deleted_at          timestamp [note: "soft delete"]
  created_at          timestamp [not null]
  updated_at          timestamp [not null]

  Indexes {
    (status)
    (valid_from, valid_until)
    (deleted_at)
  }

  note: "CouponTemplate(쿠폰 정책 마스터). 어드민이 생성하고 유저에게 발급"
}

// =========================
// IssuedCoupon (발급된 쿠폰 - 유저 귀속)
// =========================
Table issued_coupons {
  id                  bigint [pk, increment, note: "발급 쿠폰 PK"]
  user_id             bigint [not null, note: "users.id FK"]
  coupon_template_id  bigint [not null, note: "coupon_templates.id FK"]
  code                varchar(100) [unique, not null, note: "발급 단위 유니크 코드"]
  status              varchar(20) [not null, note: "ISSUED_COUPON_STATUS: ISSUED, RESERVED, REDEEMED, EXPIRED, CANCELED"]
  issued_at           timestamp [not null, note: "발급 시각"]
  redeemed_order_id   bigint [note: "orders.id. 사용 확정(REDEEMED) 시 연결"]
  expired_at          timestamp [note: "만료 시각"]
  deleted_at          timestamp [note: "soft delete"]
  created_at          timestamp [not null]
  updated_at          timestamp [not null]

  Indexes {
    (user_id, status)
    (coupon_template_id)
    (code) [unique]
    (redeemed_order_id)
    (deleted_at)
  }

  note: '''
    IssuedCoupon(발급 쿠폰). 유저 귀속.
    - ISSUED: 발급됨 (사용 가능)
    - RESERVED: 주문서에서 홀드 중
    - REDEEMED: 결제 성공으로 사용 확정
    - EXPIRED: 유효기간 만료
    - CANCELED: 관리자/시스템 취소
  '''
}

// =========================
// CouponTarget (쿠폰 적용 대상)
// =========================
Table coupon_targets {
  id                  bigint [pk, increment, note: "쿠폰 대상 PK"]
  coupon_template_id  bigint [not null, note: "coupon_templates.id FK"]
  target_type         varchar(20) [not null, note: "COUPON_TARGET_TYPE: ALL, PRODUCT, BRAND"]
  target_id           bigint [note: "대상 ID. ALL이면 NULL, PRODUCT면 products.id, BRAND면 brands.id"]
  deleted_at          timestamp [note: "soft delete"]
  created_at          timestamp [not null]

  Indexes {
    (coupon_template_id)
    (target_type, target_id)
    (deleted_at)
  }

  note: "CouponTarget. 템플릿 1개가 여러 대상에 적용 가능(1:N). 예: 의류 브랜드 A + 브랜드 B"
}

// ==========================================================
// Relationships
// ==========================================================

// Core 관계
Ref brand_product: products.brand_id > brands.id
Ref product_like_user: product_likes.user_id > users.id
Ref product_like_product: product_likes.product_id > products.id
Ref brand_like_user: brand_likes.user_id > users.id
Ref brand_like_brand: brand_likes.brand_id > brands.id
Ref order_user: orders.user_id > users.id
Ref order_item_order: order_items.order_id > orders.id
// order_items.product_id는 FK 아님 (추적용 참조만)

// Inventory 관계
Ref inventory_product: inventories.product_id > products.id

// Coupon 관계
Ref coupon_issue_user: issued_coupons.user_id > users.id
Ref coupon_issue_template: issued_coupons.coupon_template_id > coupon_templates.id
Ref coupon_issue_order: issued_coupons.redeemed_order_id > orders.id
Ref coupon_target_template: coupon_targets.coupon_template_id > coupon_templates.id
