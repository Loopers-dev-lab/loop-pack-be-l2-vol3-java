{
  "permissions": {
    "allow": [
      "Bash(git add:*)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/home/ubuntu/.claude-hooks/notify.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/home/ubuntu/.claude-hooks/notify.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
